{
  "name": "oryx-example-data",
  "main": "index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oryx-example",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ]
}
